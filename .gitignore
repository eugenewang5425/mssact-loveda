# ================= 环境与备份（严禁入库）=================
.env
backups/
_local_*
.torch_inductor_cache/
.torch_cache/
__pycache__/
*.pyc

# ================= 模型权重与训练产物 =================
# 注意: checkpoints/ 已并入 results/checkpoints/
*.pt
*.npz
*.log
results/checkpoints/*.json
results/checkpoints/*.pt

# ================= 原始数据与预解码数据集 =================
data/
_data/
_gf_data/
results/fast_dataset/
ladder_data/

# ================= 评估结果（可复现生成；仅保留汇总 JSON）=================
results/fulltile_eval/preds_*/
results/heldout_test/*.png
results/tta_eval*/**/*.png
results/overfit_diag/*.png
results/ladder_eval/*.png
results/consensus_analysis/pred_*.npz
results/consensus_analysis/labels.npz
results/consensus_analysis/*.bak_*.json

# ================= 运行日志 =================
results/logs/

# ================= 临时与剖析产物 =================
check_*.png
stdout.txt
*_new.pdf
*_v3.pdf
profile_output/
results/artifacts/gpu_sample_*.json
results/artifacts/bench_*.json

# ================= 环境被剥离时 torch 会建的字面 ~ 目录 =================
# HOME/USERPROFILE 缺失时 os.path.expanduser("~") 原样返回 "~"，torch.hub 便以
# 相对路径 ./~/ 建缓存(基准是 CWD，即仓库根)，把 97MB 预训练权重下进仓库。
# 已由 paths.py 显式设定 TORCH_HOME 根治；此处再兜一层，避免误提交。
~/
*.pth

# ================= 报告产物 =================
# 入库：reports/项目报告_<日期>.pdf —— **只保留最新一版**
# 日期名是版本标记（内容更新即换名，不覆盖），但交付件不堆积：生成新版后，
# 旧版从索引移除并移入 backups/（见 2026-09-14 的处理）。
# 不入库：HTML（可再生）、根目录下的无日期副本（历史遗留）
reports/项目报告_*.html
reports/项目报告.pdf
项目报告.pdf
# 备份产物一律不入库（约定放 backups/，该目录本身已在上方忽略）
# 这三条是兜底：曾因"没有规则覆盖 .bak"而被 git add -A 扫进仓库
*.bak
*.bak_*
*_bak_*.pdf
_compat_check/
